*.o
# The assembly this compiler writes, and not the assembly written by
# hand: the runtime start-up files and two the tests need are sources.
*.s
!rt/*.s
!test/*.s
!test/xtensa/*.s
build*/
lua-amd64*
lua-riscv64*
.claude/

# a stray `-o -`, and qemu dumps from a failed run
/-
*.core

# notes left in the tree to be read and deleted, never committed
*do-not-commit*
delete-after-reading-*
