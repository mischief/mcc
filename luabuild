#!/bin/sh
# Build the whole of Lua with this compiler, link it against the host's C
# library, and check that it answers exactly as a build by the system
# compiler does.  LUA_SRC points at a Lua source tree.
#
#   ./luabuild [amd64|riscv64]
set -e
cd "$(dirname "$0")"
here=$(pwd)
LUA=${LUA:-lua5.4}
LUA_SRC=${LUA_SRC:-$HOME/src/lua}
tgt=${1:-amd64}
out=${OUT:-${TMPDIR:-/tmp}/comp-luabuild-$tgt}

case $tgt in
amd64)	cc=gcc; run=;;
riscv64) cc=riscv64-linux-gnu-gcc; run="qemu-riscv64 ";;
*)	echo "no toolchain for $tgt"; exit 2;;
esac

if [ ! -d "$LUA_SRC" ]; then
	echo "skip luabuild: set LUA_SRC to a Lua source tree"
	exit 0
fi
command -v "$cc" >/dev/null || { echo "skip luabuild $tgt: no $cc"; exit 0; }
[ -z "$run" ] || command -v "${run% }" >/dev/null || {
	echo "skip luabuild $tgt: no ${run% }"; exit 0; }

rm -rf "$out"
mkdir -p "$out/mine" "$out/ref"

# The reference build uses the same headers, so that a difference can only
# come from the code this compiler generates.  Its own stdarg.h and stddef.h
# come first, because its va_start is not this one.
sysinc=$(dirname "$($cc -print-file-name=include/stdarg.h)")
refflags="-w -nostdinc -Iinclude/hosted -isystem $sysinc -isystem include"
ldflags="-static -no-pie"

n=0
for f in "$LUA_SRC"/*.c; do
	b=$(basename "$f" .c)
	case $b in ltests|onelua) continue;; esac
	$LUA cc.lua -t $tgt -Iinclude -Iinclude/hosted -I"$LUA_SRC" \
		"$f" -o "$out/mine/$b.s"
	$cc -c -o "$out/mine/$b.o" "$out/mine/$b.s"
	$cc $refflags -I"$LUA_SRC" -c -o "$out/ref/$b.o" "$f"
	n=$((n + 1))
done
$cc $ldflags -o "$out/mine/lua" "$out"/mine/*.o rt/softfp.c rt/varargs.c -lm \
	2>/dev/null
$cc $ldflags -o "$out/ref/lua" "$out"/ref/*.o -lm 2>/dev/null

${run}"$out/mine/lua" test/stress.lua > "$out/mine.txt" 2>&1 || true
${run}"$out/ref/lua"  test/stress.lua > "$out/ref.txt"  2>&1 || true
# a table prints its own address, which is not a property of the compiler
sed -i 's/0x[0-9a-f]*/ADDR/g' "$out/mine.txt" "$out/ref.txt"

if cmp -s "$out/mine.txt" "$out/ref.txt"; then
	echo "ok   $tgt Lua built from $n sources answers as gcc's does" \
	     "($(wc -l < "$out/mine.txt") lines)"
else
	echo "FAIL $tgt Lua differs from the reference build"
	diff "$out/ref.txt" "$out/mine.txt" | head -40
	exit 1
fi
