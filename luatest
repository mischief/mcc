#!/bin/sh
# Run the upstream Lua test suite on a Lua built by this compiler, and on one
# built by the system compiler, and report both.  LUA_SRC points at a Lua
# source tree that carries its testes directory.
#
#   ./luatest [amd64|riscv64]
set -e
cd "$(dirname "$0")"
here=$(pwd)
LUA_SRC=${LUA_SRC:-$HOME/src/lua}
tgt=${1:-amd64}
out=${OUT:-${TMPDIR:-/tmp}/comp-luabuild-$tgt}

case $tgt in
amd64)	 run=;;
riscv64) run="qemu-riscv64 ";;
*)	 echo "no toolchain for $tgt"; exit 2;;
esac

if [ ! -d "$LUA_SRC/testes" ]; then
	echo "skip luatest: no $LUA_SRC/testes"
	exit 0
fi
if [ ! -x "$out/mine/lua" ]; then
	"$here/luabuild" "$tgt" >/dev/null || exit 1
fi

# main.lua drives the interpreter as a subprocess and wants readline and a
# POSIX build, which neither of these is.  _port skips it and the rest of the
# non-portable tests; everything else runs, including the heavy ones.
for who in ref mine; do
	[ -x "$out/$who/lua" ] || continue
	printf 'ok   %s %s: ' "$tgt" "$who"
	( cd "$LUA_SRC/testes"
	  ulimit -S -s 1100
	  ${run}"$out/$who/lua" -e '_port=true' -W all.lua ) \
		> "$out/$who.testes" 2>&1 || true
	files=$(grep -ac "FILE '" "$out/$who.testes" || true)
	if grep -aq 'final OK' "$out/$who.testes"; then
		echo "$files test files, final OK," \
		     "$(grep -a '^total time' "$out/$who.testes")"
	else
		echo "FAILED"
		tail -6 "$out/$who.testes"
		exit 1
	fi
done
