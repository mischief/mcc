#!/bin/sh
# Build Lua with this compiler, then run this compiler inside that Lua and
# build Lua again.  The second one has to be the first one, byte for byte:
# a compiler that miscompiles the interpreter it runs on would not reach a
# fixed point.
#
#   ./bootstrap [amd64|riscv64]
set -e
cd "$(dirname "$0")"
tgt=${1:-amd64}
dir=${TMPDIR:-/tmp}/comp-boot-$tgt
case $tgt in
amd64)   run=;;
riscv64) run="qemu-riscv64 ";;
*)       echo "1..0 # SKIP no toolchain for $tgt"; exit 0;;
esac

rm -rf "$dir"
mkdir -p "$dir"

tools/buildlua "$tgt" "$dir/one" "$dir/one.ref"
echo "ok 1 - stage 1: Lua built by this compiler on the system Lua"

# a wrapper, because buildlua calls $LUA as a command
printf '#!/bin/sh\nexec %s%s "$@"\n' "$run" "$dir/one" > "$dir/stage1"
chmod +x "$dir/stage1"

LUA=$dir/stage1 tools/buildlua "$tgt" "$dir/two" "$dir/two.ref"
echo "ok 2 - stage 2: Lua built by this compiler on the Lua of stage 1"

if cmp -s "$dir/one" "$dir/two"; then
	echo "ok 3 - $tgt reaches a fixed point: stage 2 is stage 1, byte for byte"
else
	echo "not ok 3 - $tgt reaches a fixed point"
fi
echo "1..3"
cmp -s "$dir/one" "$dir/two"
