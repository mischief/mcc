#!/bin/sh
# Build Lua with this compiler, then run this compiler inside that Lua and
# build Lua again.  The second one has to be the first one, byte for byte:
# a compiler that miscompiles the interpreter it runs on would not reach a
# fixed point.
#
#   ./bootstrap [amd64|riscv64]
set -e
cd "$(dirname "$0")"
tgt=${1:-amd64}
one=${TMPDIR:-/tmp}/comp-boot1-$tgt
two=${TMPDIR:-/tmp}/comp-boot2-$tgt
case $tgt in
amd64)   run=;;
riscv64) run="qemu-riscv64 ";;
*)       echo "no toolchain for $tgt"; exit 2;;
esac

OUT=$one ./luabuild "$tgt" >/dev/null
echo "ok   stage 1: Lua built by this compiler on the system Lua"

# a wrapper, because luabuild calls $LUA as a command
stage1=$one/stage1
printf '#!/bin/sh\nexec %s%s "$@"\n' "$run" "$one/mine/lua" > "$stage1"
chmod +x "$stage1"

LUA=$stage1 OUT=$two ./luabuild "$tgt" >/dev/null
echo "ok   stage 2: Lua built by this compiler on the Lua of stage 1"

if cmp -s "$one/mine/lua" "$two/mine/lua"; then
	echo "ok   $tgt reaches a fixed point: stage 2 is stage 1, byte for byte"
else
	echo "FAIL $tgt: stage 2 differs from stage 1"
	exit 1
fi
