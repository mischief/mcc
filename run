#!/bin/sh
# Run every test.  SHOW=1 prints the generated assembly.
set -e
cd "$(dirname "$0")"
LUA=${LUA:-lua5.4}

$LUA test/amd64.lua
$LUA test/riscv.lua
$LUA test/exec.lua amd64
$LUA test/cc.lua amd64
$LUA test/cc.lua amd64 types
$LUA test/cc.lua amd64 flt
$LUA test/cc.lua amd64 init
$LUA test/cc.lua amd64 va
$LUA test/cc.lua amd64 abi
$LUA test/cc.lua amd64 lang
$LUA test/cc.lua amd64 asm
$LUA test/cc.lua amd64 wide
# The same lowering a 32-bit target uses, forced on here so that it can be
# run against a compiler that has the type natively.
for t in prog types flt init va abi lang wide; do
	$LUA test/cc.lua amd64 $t wide
done
if command -v riscv64-linux-gnu-gcc >/dev/null && command -v qemu-riscv64 >/dev/null
then
	$LUA test/exec.lua riscv64
	$LUA test/exec.lua riscv32
	$LUA test/cc.lua riscv64
	$LUA test/cc.lua riscv64 types
	$LUA test/cc.lua riscv64 flt
	$LUA test/cc.lua riscv64 init
	$LUA test/cc.lua riscv64 va
	$LUA test/cc.lua riscv64 abi
	$LUA test/cc.lua riscv64 lang
	$LUA test/cc.lua riscv64 asm
	$LUA test/cc.lua riscv64 wide
	for t in prog types flt init va abi lang wide; do
		$LUA test/cc.lua riscv64 $t wide
	done
else
	echo "skip riscv: need riscv64-linux-gnu-gcc and qemu-riscv64"
fi

# The assembler against the real one, on everything this compiler makes.
if command -v riscv64-linux-gnu-as >/dev/null
then
	if [ -d "${OUT:-${TMPDIR:-/tmp}}/comp-luabuild-riscv64/mine" ]; then
		$LUA test/as.lua "${TMPDIR:-/tmp}"/comp-luabuild-riscv64/mine/*.s
	fi
	$LUA test/self.lua riscv64
fi

# And the same thing twice: the compiler run on the Lua it built.
./bootstrap amd64

# The whole of Lua, built by this compiler and run against a build by the
# system one.
./luabuild amd64
./luabuild riscv64

# The preprocessor against the real thing, when a Lua tree is at hand.
LUA_SRC=${LUA_SRC:-$HOME/code/c/lua-os/lua}
if [ -d "$LUA_SRC" ]; then
	CPPINC="$LUA_SRC:$(dirname "$LUA_SRC")/include" \
		$LUA test/cpp.lua "$LUA_SRC"/*.c | grep -c '^ok' \
		| xargs printf 'ok   cpp matches gcc -E on %s Lua sources\n'
else
	echo "skip lua cpp: set LUA_SRC to a Lua source tree"
fi
