#!/bin/sh
# Run every test.  SHOW=1 prints the generated assembly.
set -e
cd "$(dirname "$0")"
LUA=${LUA:-lua5.4}

$LUA test/amd64.lua
$LUA test/riscv.lua
$LUA test/exec.lua amd64
$LUA test/cc.lua amd64
$LUA test/cc.lua amd64 types
$LUA test/cc.lua amd64 flt
$LUA test/cc.lua amd64 init
$LUA test/cc.lua amd64 va
if command -v riscv64-linux-gnu-gcc >/dev/null && command -v qemu-riscv64 >/dev/null
then
	$LUA test/exec.lua riscv64
	$LUA test/exec.lua riscv32
	$LUA test/cc.lua riscv64
	$LUA test/cc.lua riscv64 types
	$LUA test/cc.lua riscv64 flt
	$LUA test/cc.lua riscv64 init
	$LUA test/cc.lua riscv64 va
else
	echo "skip riscv: need riscv64-linux-gnu-gcc and qemu-riscv64"
fi

# The preprocessor against the real thing, when a Lua tree is at hand.
LUA_SRC=${LUA_SRC:-$HOME/code/c/lua-os/lua}
if [ -d "$LUA_SRC" ]; then
	CPPINC="$LUA_SRC:$(dirname "$LUA_SRC")/include" \
		$LUA test/cpp.lua "$LUA_SRC"/*.c | grep -c '^ok' \
		| xargs printf 'ok   cpp matches gcc -E on %s Lua sources\n'
else
	echo "skip lua cpp: set LUA_SRC to a Lua source tree"
fi
